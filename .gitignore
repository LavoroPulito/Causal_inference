# Virtualenv — never versioned, recreated with the instructions in the README
env_tigramite/
.venv/

# External dependency, not part of this project
tigramite/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# LaTeX: regenerated by compiling. The PDF is versioned instead,
# because it is the document that gets shared.
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz

# macOS
.DS_Store

# Local editor configuration
pyrightconfig.json
.envrc

# Personal files
PersonalNotes.md

# Archives moved to and from Kaggle: copies of versioned files
kaggle_input.zip
kaggle_input/
llm_output.zip

# Latest CNN archive, overwritten at every update: the corpus is versioned instead
cache_cnn/truth_archive_latest.json

# Synthetic prices: regenerated by 03b in a second
data/prices/synthetic/*.parquet

# Databento data: licensed, not to be redistributed
data/prices/raw/databento/
data/prices/databento/
# per-episode returns computed from Databento prices (aggregated regressions are kept)
data/event_study/wti/car.parquet
data/event_study/brent/car.parquet
data/event_study/gold/car.parquet
data/event_study/sp500/car.parquet
data/event_study/eurusd/car.parquet
